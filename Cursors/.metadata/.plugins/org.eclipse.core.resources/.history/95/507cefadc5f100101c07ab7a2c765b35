package iterator;

import java.util.*;
public class Employee_App {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		Vector <Employee> v = new Vector<>();
		System.out.print("Enter the size: ");
		int size = sc.nextInt();
		for(int i = 0; i <size; i++) {
			System.out.print("Enter the Name: ");
			String name = sc.next();
			sc.nextLine();
			
			System.out.print("Enter the Salary: ");
			double salary = sc.nextDouble();
			
			System.out.println();
			Employee emp = new Employee(name, salary);
			v.add(emp);
		}
		
		ListIterator<Employee> li = v.listIterator();
        System.out.println("\n--- Forward Traversal (hasNext, next, nextIndex) ---");
        while(li.hasNext()) {
        	System.out.println("Index: "+li.nextIndex());
        	Employee e = li.next();
        	System.out.println(e.getId() + " " + e.getName() + " " + e.getSalary());
        }
		
        System.out.println("\n--- Backward Traversal (hasPrevious, previous, previousIndex) ---");
        while(li.hasPrevious()) {
        	System.out.println("Index: "+ li.previousIndex());
        	Employee e = li.previous();
        	System.out.println(e.getId() + " " + e.getName() + " " + e.getSalary());        	
        }
        
        System.out.println("\n--- add() method demonstration ---");
        li = v.listIterator();
        li.add(new Employee("ExtraEmp", 20000));
        
        System.out.println("\n--- remove() method demonstration ---");
        while(li.hasNext()) {
        	Employee e = li.next();
        	if(e.getSalary() > 8000) {
        		li.remove();
        	}
        }
        
        System.out.print("Final List of Employee: ");
        for(Employee e:v) {
        	System.out.println(e.getId()+" "+e.getName()+" "+e.getSalary());
        }
	}
}
 